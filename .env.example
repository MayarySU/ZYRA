# ─────────────────────────────────────────────────────────────
# ZYRA — Variables de entorno
# Copia este archivo a .env.local y rellena los valores.
# .env.local está ignorado por git; NUNCA subas secretos.
# ─────────────────────────────────────────────────────────────

# Supabase (públicas — seguras para el navegador)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase (SECRETA — solo servidor; nunca exponer con NEXT_PUBLIC_*)
SUPABASE_SECRET_KEY=sb_secret_xxx

# Conexión directa a PostgreSQL (migraciones / scripts). Solo servidor.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Cloudflare R2 (SECRETAS — solo servidor)
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=zyra-evidencias

# URL pública de la app (para enlaces de recuperación, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:9002
